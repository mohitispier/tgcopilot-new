# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.tgcopilot.com

# Contact / consultation forms. Leave empty until a form service is connected.
# Works with any endpoint that accepts a JSON POST, e.g. Formspree (https://formspree.io/f/xxxx)
# or Web3Forms (https://api.web3forms.com/submit, plus NEXT_PUBLIC_WEB3FORMS_KEY).
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_WEB3FORMS_KEY=

# Chrome Web Store listing for the extension. Leave empty until it is published.
NEXT_PUBLIC_CHROME_STORE_URL=

# Analytics (carried over from the old site)
NEXT_PUBLIC_GTM_ID=GTM-PZ64GV77
